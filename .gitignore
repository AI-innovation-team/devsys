# ── 机密：绝不提交 ──
.env
**/.env
.secrets

# ── 依赖 / 构建产物 ──
node_modules/
**/node_modules/
frontend/dist/
dist/
.vite/

# ── Rust / Tauri 构建产物 ──
src-tauri/target/

# ── tsnet sidecar 编译产物（28MB，构建时从 tsnet-helper/ 生成）──
tsnet-helper/tsnet-helper

# ── Python ──
__pycache__/
**/__pycache__/
*.pyc
.venv/
**/.venv/
*.egg-info/

# ── 运行期数据（用户凭据等，只存在于网关机，绝不入库）──
**/data/
# 例外：前端数据源抽象层是源码，不是运行期数据
!frontend/src/data/
*.enc
portal.key

# ── 杂项 ──
.DS_Store
*.log

# 部署渲染产物
build/

# 真实拓扑（本地）——用 config.yaml.example 做模板
config.yaml

# 真实 team.yaml 是测试/使用产物（含真实拓扑），只提交 *.example.yaml
examples/team.yaml

# GitHub 花名册缓存（本地，不入 git；由 sync 刷新）
.github-roster.json
**/.github-roster.json
